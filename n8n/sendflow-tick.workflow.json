{
  "name": "[SendFlow] Motor de envio (tick de 1 min)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "A cada 1 minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "appUrl",
              "value": "https://sendflow.suaempresa.com.br",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "cronSecret",
              "value": "COLE_O_MESMO_VALOR_DE_CRON_SECRET",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.appUrl }}/api/dispatch/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $json.cronSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 70000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Acordar o motor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "x1",
              "leftValue": "={{ $json.restante }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Sobrou fila?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.appUrl }}/api/dispatch/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $('Config').first().json.cronSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 70000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Continuar a fila",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, -100]
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Fila vazia",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 100]
    }
  ],
  "connections": {
    "A cada 1 minuto": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Acordar o motor", "type": "main", "index": 0 }]]
    },
    "Acordar o motor": {
      "main": [[{ "node": "Sobrou fila?", "type": "main", "index": 0 }]]
    },
    "Sobrou fila?": {
      "main": [
        [{ "node": "Continuar a fila", "type": "main", "index": 0 }],
        [{ "node": "Fila vazia", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
