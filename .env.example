# ─────────────────────────────────────────────────────────────────────────────────
# SendFlow — variáveis de ambiente
#
# Copie para `.env.local` no seu computador, e coloque as mesmas no painel da
# hospedagem (Vercel → Settings → Environment Variables) para produção.
#
# A tela Configurações do próprio sistema mostra quais destas estão faltando e o que
# cada ausência quebra — é o lugar mais rápido para conferir depois de subir.
# ─────────────────────────────────────────────────────────────────────────────────

# ── Banco (obrigatório) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# A service_role key. NUNCA vai para o navegador — só o servidor a lê.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=campanhas-midia

# ── URL pública (importante) ─────────────────────────────────────────────────────
# O domínio definitivo do sistema, sem barra no fim.
# Vai embutido no pixel de abertura, em cada link rastreado e no link de descadastro
# de CADA e-mail enviado. Se mudar depois, as campanhas antigas ficam com links
# quebrados — e não há como consertar, o e-mail já está na caixa das pessoas.
APP_URL=https://sendflow.suaempresa.com.br

# ── Login do painel (obrigatório em produção) ────────────────────────────────────
# Sem estas duas, o painel fica ABERTO para qualquer pessoa com o endereço — e daqui
# se dispara para todos os grupos e para toda a base de e-mail.
# Gere o segredo com:  openssl rand -hex 32
AUTH_SECRET=
# Formato: email:senha,email2:senha2
APP_USERS=voce@empresa.com.br:uma-senha-longa

# ── WhatsApp: API oficial da Meta (o disparo em massa) ───────────────────────────
# É a Cloud API. Ela — e só ela — faz disparo em massa para contatos: é a regra do
# sistema, e está no banco (trigger da 0019), não só na tela.
#
# Por quê: um chip lido por QR Code aguenta ~500 mensagens/dia antes de a Meta
# restringir o número por 24 h. A API oficial manda dezenas por segundo sem punição,
# porque o conteúdo já foi aprovado antes, no template.
# Em compensação, ela NÃO envia para grupo — grupo continua na Evolution, abaixo.
#
# Token permanente de um usuário de sistema do Business Manager (não o token de teste,
# que expira em 24 h). Precisa das permissões whatsapp_business_messaging e
# whatsapp_business_management.
META_ACCESS_TOKEN=
# Id do app da Meta. Liga o botão "Conectar com a Meta" (Cadastro Incorporado), que
# guarda o token de CADA número no cofre do Supabase — aí META_ACCESS_TOKEN vira opcional.
# O id da configuração do cadastro (config_id) é colado na tela Conexões.
META_APP_ID=
# Segredo do app (Configurações básicas do app no painel da Meta). É com ele que o
# webhook confere a assinatura X-Hub-Signature-256 — sem ele o webhook recusa TUDO,
# de propósito: um webhook aberto de WhatsApp permite forjar entregas e descadastrar
# a base inteira.
META_APP_SECRET=
# Uma frase que você inventa e repete no painel da Meta ao cadastrar o webhook. A Meta
# manda ela de volta no GET de verificação.
META_WEBHOOK_VERIFY_TOKEN=
# Opcional: a versão da Graph API. Só mexa quando a Meta aposentar a atual.
# META_API_VERSION=v23.0

# ── WhatsApp: Evolution API (obrigatório para disparar) ──────────────────────────
# URL do seu servidor Evolution (v2.x), sem barra no fim.
EVOLUTION_API_URL=https://evolution.suaempresa.com.br
# A chave GLOBAL do servidor (AUTHENTICATION_API_KEY na Evolution).
EVOLUTION_API_KEY=
# Segredo que viaja na URL do webhook da Evolution. Sem ele, qualquer um pode mandar
# eventos falsos e sujar os KPIs de entrega e leitura.
WEBHOOK_SECRET=

# ── E-mail: escolha UM dos dois caminhos ─────────────────────────────────────────
# Deixe em branco para o sistema escolher sozinho (Resend ganha quando os dois existem).
EMAIL_PROVIDER=

# Caminho A — Resend (recomendado: webhook nativo de entrega, bounce e spam)
RESEND_API_KEY=
# Segredo do webhook (Resend → Webhooks → Signing Secret). Começa com whsec_
RESEND_WEBHOOK_SECRET=

# Caminho B — SMTP (Hostinger, Zoho, Gmail, Brevo… qualquer caixa que você já tenha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Motor de envio ───────────────────────────────────────────────────────────────
# Protege /api/dispatch/tick. O agendador (Vercel Cron ou n8n) manda este valor no
# cabeçalho x-cron-secret.
CRON_SECRET=
